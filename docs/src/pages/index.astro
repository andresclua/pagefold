---
import Base from '../layouts/Base.astro'
---

<Base title="Page transitions">
  <section>
    <h1>Pagefold</h1>
    <p class="lead">Page transitions for server-rendered websites.</p>
    <p>Work in progress. Follow along on GitHub.</p>
    <p>
      <a class="btn" href="/docs/getting-started">Read the docs</a>
      <a href="/showcase">See the showcase</a>
    </p>
  </section>
</Base>

<style>
  section {
    padding-block: 4rem;
  }
  h1 {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    margin: 0 0 0.5rem;
  }
  .lead {
    font-size: 1.25rem;
    color: var(--muted);
  }
  .btn {
    display: inline-block;
    margin-right: 1rem;
    padding: 0.6rem 1.1rem;
    border-radius: 8px;
    background: var(--primary);
    color: var(--on-primary);
    text-decoration: none;
  }
</style>
