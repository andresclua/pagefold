---
import { Code } from 'astro:components'
import Base from '../layouts/Base.astro'
import { version } from '../../../package.json'

const themes = { light: 'github-light', dark: 'github-dark' }

const features = [
  {
    title: 'Works with the HTML you have',
    text: 'No API and no special responses. Pagefold fetches your pages and swaps one container.',
    icon: 'M4 5h16v14H4zM4 9h16M8 13h5',
  },
  {
    title: 'Cancels what nobody needs',
    text: 'Click twice, and the first request is aborted, not left running in the background.',
    icon: 'M12 3a9 9 0 100 18 9 9 0 000-18zM9 9l6 6M15 9l-6 6',
  },
  {
    title: 'Small and modular',
    text: 'A 7.5 KB core with no dependencies. Every module is its own import, so you ship what you use.',
    icon: 'M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5',
  },
  {
    title: 'Animate with anything',
    text: 'CSS, GSAP, Motion, the Web Animations API or the View Transitions API. Your choice.',
    icon: 'M5 19L19 5M14 5h5v5M5 9V5M9 5H5M19 15v4M15 19h4',
  },
  {
    title: 'Accessible by default',
    text: 'Announces the new page, moves focus, and skips motion when people ask for less of it.',
    icon: 'M12 4a1.5 1.5 0 100 3 1.5 1.5 0 000-3zM5 9l7 1 7-1M12 10v4m0 0l-3 6m3-6l3 6',
  },
  {
    title: 'A hook at every step',
    text: 'Fully typed, awaited, replaceable. Plugins use the same API you do.',
    icon: 'M9 3v5M15 3v5M7 8h10v3a5 5 0 01-10 0zM12 16v5',
  },
]

const modules = [
  { slug: 'head', name: 'Head', size: '1.3', text: 'Keeps the title, meta tags and stylesheets in sync with each page.', icon: 'M4 5h16v4H4zM4 13h10M4 17h7' },
  { slug: 'scripts', name: 'Scripts', size: '0.9', text: 'Runs the scripts of the new page, in order and only once.', icon: 'M8 7l-5 5 5 5M16 7l5 5-5 5' },
  { slug: 'js', name: 'JS', size: '1.2', text: 'Animate with GSAP, Motion or any JavaScript animation library.', icon: 'M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z' },
  { slug: 'overlap', name: 'Overlap', size: '1.4', text: 'The old and the new page animate at the same time: crossfades and pushes.', icon: 'M3 5h12v12H3zM9 9h12v12H9z' },
  { slug: 'preload', name: 'Preload', size: '2.2', text: 'Fetches pages on hover or as links scroll into view, so clicks feel instant.', icon: 'M13 3L5 14h6l-1 7 8-11h-6z' },
  { slug: 'a11y', name: 'A11y', size: '1.9', text: 'Announces the new page, moves focus and respects reduced motion.', icon: 'M12 4a1.5 1.5 0 100 3 1.5 1.5 0 000-3zM5 9l7 1 7-1M12 10v4m0 0l-3 6m3-6l3 6' },
  { slug: 'scroll', name: 'Scroll', size: '2.1', text: 'Smooth scrolling to the top and to anchors, with room for a fixed header.', icon: 'M12 4v16M8 8l4-4 4 4M8 16l4 4 4-4' },
  { slug: 'body-class', name: 'Body class', size: '0.8', text: 'Copies the body class of the new page so page-specific styles keep working.', icon: 'M20 12l-8 8-9-9V3h8zM7.5 7.5h.01' },
  { slug: 'route-name', name: 'Route name', size: '1.3', text: 'Names your pages and picks the animation by where you come from and where you go.', icon: 'M12 21s-6-5.5-6-10a6 6 0 0112 0c0 4.5-6 10-6 10zM12 8.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5z' },
  { slug: 'progress', name: 'Progress', size: '1.2', text: 'A thin loading bar for the visits that take a while.', icon: 'M4 9h16v6H4zM6 11h8v2H6z' },
  { slug: 'forms', name: 'Forms', size: '1.5', text: 'Submits forms without a reload, with the same transitions as links.', icon: 'M4 4h16v16H4zM8 9h8M8 13h8M8 17h4' },
  { slug: 'fragment', name: 'Fragment', size: '1.4', text: 'Replaces only part of the page, like a detail panel, and leaves the rest alone.', icon: 'M4 4h7v7H4zM13 4h7v4h-7zM13 12h7v8h-7zM4 13h7v7H4z' },
  { slug: 'analytics', name: 'Analytics', size: '0.9', text: 'Sends a page view to GA4, Tag Manager or Matomo after every visit.', icon: 'M4 20V4M4 20h16M8 16v-4M12 16V8M16 16v-6' },
  { slug: 'debug', name: 'Debug', size: '1.0', text: 'Logs every hook with its timing while you build.', icon: 'M9 9h6v8a3 3 0 01-6 0zM9 5l1.5 2M15 5l-1.5 2M5 11h4M15 11h4M5 17h4M15 17h4' },
]
const markPaths = ['M0 968V440C0 215 270 74 400 57L850 1C925 2 990 60 990 130C990 220 920 275 830 291L500 334C330 355 180 480 180 660V968A90 90 0 0 1 0 968Z', 'M304 1138V800C304 690 385 575 500 545L900 481C990 460 1077 380 1077 330V190C1130 200 1200 270 1200 350C1205 480 1170 560 1090 615C1050 655 1000 672 900 690L650 729C530 755 478 820 478 910V1138Z', 'M600 985C600 925 630 885 700 865L960 817C1050 800 1130 750 1182 688C1195 740 1196 790 1176 850C1140 910 1090 970 1000 1006L700 1057C650 1062 600 1040 600 985Z']
---

<Base title="Page transitions">
  <div data-home>
    <section class="hero">
      <div class="wrap hero-inner">
        <div class="copy">
          <p class="eyebrow"><span class="dot"></span> v{version} · MIT</p>
          <h1>Pages that <em>fold</em> into each other.</h1>
          <p class="lead">
            Page transitions for server-rendered websites. Keep your HTML, add one container and one
            line of JavaScript.
          </p>
          <div class="cta">
            <a class="btn primary" href="/docs/getting-started/">Get started</a>
            <a class="btn ghost" href="https://github.com/andresclua/pagefold">GitHub</a>
          </div>
          <button class="install" data-copy="npm install pagefold" aria-label="Copy install command">
            <span class="prompt">$</span> npm install pagefold
            <span class="hint"><span class="idle">copy</span><span class="done">copied</span></span>
          </button>
        </div>

        <div class="mark" aria-hidden="true">
          <div class="halo" data-drift="60" data-speed="0.004"></div>
          {
            markPaths.map((d, i) => (
              <svg class="piece" viewBox="0 0 1202 1138" data-drift={[3, 4, 5][i]} data-speed="0.007">
                {i === 0 && (
                  <defs>
                    <linearGradient id="pf-hero" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1202" y2="1138">
                      <stop stop-color="#FF4165" />
                      <stop offset="1" stop-color="#FF9C2B" />
                    </linearGradient>
                  </defs>
                )}
                <path d={d} fill="url(#pf-hero)" />
              </svg>
            ))
          }
        </div>
      </div>
      <p class="scroll-cue" aria-hidden="true">Scroll <i></i></p>
    </section>

    <section class="story" aria-label="How a visit works">
      <div class="stage-pin">
        <div class="wrap story-inner">
          <div class="rail" aria-hidden="true"><i></i></div>
          <div class="lines">
            <div class="line">
              <span class="chap">01 · A click</span>
              <h2>Someone clicks a link.</h2>
              <p>Pagefold catches it before the browser throws the page away.</p>
            </div>
            <div class="line">
              <span class="chap">02 · A fetch</span>
              <h2>The next page is fetched.</h2>
              <p>Plain HTML, your own server. Click twice and the first request is aborted.</p>
            </div>
            <div class="line">
              <span class="chap">03 · A fold</span>
              <h2>One container swaps.</h2>
              <p>The old page leaves, the new one arrives, and everything around them stays put.</p>
            </div>
          </div>
          <div class="stage" aria-hidden="true">
            <div class="sheet s1"><i></i><i></i><i></i><b class="flap"></b></div>
            <div class="sheet s2"><i></i><i></i><i></i><b class="flap"></b></div>
            <div class="sheet s3"><i></i><i></i><i></i><b class="flap"></b></div>
          </div>
        </div>
      </div>
    </section>

    <section class="chapter">
      <div class="wrap">
        <p class="chap" data-reveal>04 · What you get</p>
        <h2 class="title" data-reveal>Everything it does, in six lines.</h2>
        <p class="sub" data-reveal>Drag, or use the arrows.</p>
        <div class="sliderkit__outer" data-reveal>
          <div class="sliderkit__overflow">
            <div class="sliderkit" id="features-slider">
              {
                features.map((f, i) => (
                  <div class="sliderkit__item">
                    <article class="card">
                      <span class="n">{String(i + 1).padStart(2, '0')}</span>
                      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d={f.icon} />
                      </svg>
                      <h3>{f.title}</h3>
                      <p>{f.text}</p>
                    </article>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="chapter">
      <div class="wrap">
        <p class="chap" data-reveal>05 · Three pieces</p>
        <h2 class="title" data-reveal>Up and running in three pieces.</h2>
        <div class="steps">
          <div data-reveal>
            <span class="num">1</span>
            <h3>Mark the container</h3>
            <Code code={'<main id="pagefold" class="transition-fade">\n  ...\n</main>'} lang="html" themes={themes} defaultColor={false} />
          </div>
          <div data-reveal>
            <span class="num">2</span>
            <h3>Style the transition</h3>
            <Code code={'.transition-fade { transition: opacity .3s }\nhtml.is-animating .transition-fade {\n  opacity: 0\n}'} lang="css" themes={themes} defaultColor={false} />
          </div>
          <div data-reveal>
            <span class="num">3</span>
            <h3>Start it</h3>
            <Code code={"import Pagefold from 'pagefold'\n\nnew Pagefold()"} lang="js" themes={themes} defaultColor={false} />
          </div>
        </div>
      </div>
    </section>

    <section class="chapter modules-chapter">
      <div class="wrap">
        <p class="chap" data-reveal>06 · Modules</p>
        <h2 class="title" data-reveal>Add only what you need.</h2>
        <p class="sub" data-reveal>Every module is a separate import, and the sizes below are what each one adds. Nothing you do not use reaches your bundle.</p>
      </div>
      <div class="sliderkit__outer strip" aria-hidden="true">
        <div class="sliderkit__overflow">
          <div class="sliderkit" id="modules-marquee">
            {modules.map((m) => <div class="sliderkit__item"><span class="word">{m.name}</span></div>)}
          </div>
        </div>
      </div>
      <div class="wrap">
        <ul class="modules">
          {
            modules.map((m) => (
              <li data-reveal>
                <a class="module" href={`/docs/${m.slug}/`}>
                  <div class="top">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={m.icon} />
                    </svg>
                    <h3>{m.name}</h3>
                    <span class="size">{m.size} KB</span>
                  </div>
                  <p>{m.text}</p>
                  <code class="path">pagefold/{m.slug}</code>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="more">Every module has its own page with when to use it and every option. <a href="/docs/getting-started/">Start with the guide</a>.</p>
      </div>
    </section>

    <section class="outro">
      <div class="blob b1" data-drift="140" data-speed="0.005" aria-hidden="true"></div>
      <div class="blob b2" data-drift="110" data-speed="0.006" aria-hidden="true"></div>
      <p class="big" aria-hidden="true">Fold your pages.</p>
      <div class="wrap outro-inner">
        <h2 class="sr-only">Fold your pages.</h2>
        <div class="cta">
          <a class="btn primary" href="/docs/getting-started/">Get started</a>
          <a class="btn ghost" href="/showcase/">See the showcase</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Shared */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .chap {
    margin: 0 0 1rem;
    font: 600 0.8rem var(--font-head);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--link);
  }
  .title {
    margin: 0 0 0.8rem;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }
  .sub {
    color: var(--muted);
    margin: 0 0 2rem;
    max-width: 40rem;
  }
  .chapter {
    padding-block: clamp(4rem, 10vw, 8rem) 0;
  }
  .btn {
    display: inline-block;
    padding: 0.7rem 1.25rem;
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.15s, background 0.15s;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .primary {
    background: var(--primary);
    color: var(--on-primary);
  }
  .ghost {
    border-color: var(--border);
    color: var(--text);
    background: var(--surface);
  }
  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  /* Hero: the mark, in three pieces that drift */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - 3.4rem);
    display: grid;
    align-items: center;
    border-bottom: 1px solid var(--border);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
    padding-block: 4rem 6rem;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-family: var(--font-head);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--primary);
  }
  h1 {
    font-size: clamp(2.6rem, 6.4vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 1.25rem;
  }
  h1 em {
    font-style: normal;
    background: linear-gradient(100deg, #ff4165, #ff9c2b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    font-size: 1.2rem;
    color: var(--muted);
    max-width: 34rem;
    margin: 0 0 2rem;
  }
  .install {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    font: 0.92rem var(--font-head);
    cursor: pointer;
  }
  .prompt {
    color: var(--link);
  }
  .hint {
    margin-left: 0.5rem;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .hint .done,
  .install[data-copied] .idle {
    display: none;
  }
  .install[data-copied] .done {
    display: inline;
    color: var(--link);
  }
  .mark {
    position: relative;
    width: min(100%, 26rem);
    aspect-ratio: 1202 / 1138;
    justify-self: center;
  }
  .piece {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .halo {
    position: absolute;
    inset: -25%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--primary) 34%, transparent), transparent);
    filter: blur(24px);
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font: 0.7rem var(--font-head);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .scroll-cue i {
    width: 1px;
    height: 2.2rem;
    background: linear-gradient(var(--primary), transparent);
    animation: cue 1.8s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0% { transform: scaleY(0); }
    60% { transform: scaleY(1); }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* Chapter 1: the stage stays while the story scrolls past */
  .story {
    height: 340vh;
    border-bottom: 1px solid var(--border);
  }
  .stage-pin {
    position: sticky;
    top: 3.4rem;
    height: calc(100svh - 3.4rem);
    display: grid;
    align-items: center;
    overflow: hidden;
  }
  .story-inner {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .rail {
    width: 2px;
    height: 16rem;
    background: var(--border);
    border-radius: 2px;
  }
  .rail i {
    display: block;
    height: 100%;
    background: linear-gradient(var(--primary), var(--accent));
    transform-origin: top;
    transform: scaleY(0);
  }
  .lines {
    position: relative;
    height: 16rem;
  }
  .line {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .line h2 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .line p {
    margin: 0;
    color: var(--muted);
    max-width: 26rem;
  }
  .stage {
    position: relative;
    height: 20rem;
  }
  .sheet {
    position: absolute;
    inset: 0 14% 0 0;
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 14px;
    clip-path: polygon(0 0, calc(100% - 44px) 0, 100% 44px, 100% 100%, 0 100%);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.5);
  }
  .flap {
    position: absolute;
    top: 0;
    right: 0;
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    clip-path: polygon(0 0, 100% 100%, 0 100%);
    transform-origin: top right;
  }
  .sheet i {
    display: block;
    height: 0.7rem;
    border-radius: 4px;
    background: var(--border);
  }
  .sheet i:first-child {
    width: 55%;
    height: 1.2rem;
    background: color-mix(in srgb, var(--text) 70%, transparent);
  }
  .sheet i:nth-child(2) { width: 92%; }
  .sheet i:nth-child(3) { width: 72%; }
  .s3 { transform: translate(40px, -22px) scale(0.94); opacity: 0.45; }
  .s2 { transform: translate(20px, -11px) scale(0.97); opacity: 0.75; }

  /* Reduced motion: no pin, the three lines one under the other */
  .is-static .story {
    height: auto;
    padding-block: 4rem;
  }
  .is-static .stage-pin {
    position: static;
    height: auto;
  }
  .is-static .lines {
    height: auto;
    display: grid;
    gap: 2rem;
  }
  .is-static .line {
    position: static;
  }
  .is-static .rail,
  .is-static .scroll-cue {
    display: none;
  }

  /* Chapter 4: the slider of SliderKit */
  :global(.sliderkit__overflow) { overflow: hidden; position: relative; }
  :global(.sliderkit) { display: flex; user-select: none; will-change: transform; touch-action: pan-y; }
  :global(.sliderkit__item) { flex-shrink: 0; position: relative; }
  :global(.sliderkit__outer) { position: relative; }
  :global(.sliderkit__live),
  :global(.sliderkit__sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
    white-space: nowrap;
  }
  .card {
    height: 100%;
    min-height: 15rem;
    padding: 1.6rem;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    cursor: grab;
  }
  .card svg { color: var(--link); margin-top: 0.6rem; }
  .card .n {
    font: 700 2.6rem var(--font-head);
    background: linear-gradient(135deg, #ff4165, #ff9c2b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -0.04em;
  }
  .card h3 { margin: 0.6rem 0 0; font-size: 1.15rem; }
  .card p { margin: 0; color: var(--muted); font-size: 0.97rem; }
  :global(.sliderkit__arrows) {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    margin-top: 1rem;
  }
  :global(.sliderkit__arrow) {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  :global(.sliderkit__arrow:hover) { border-color: var(--link); }
  :global(.sliderkit__arrow--disabled) { opacity: 0.35; pointer-events: none; }
  :global(.sliderkit__arrow svg) { width: 20px; height: 20px; }
  :global(.sliderkit__pagination) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 1rem 0 0;
  }
  :global(.sliderkit__pagination-bullet) {
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--border);
    cursor: pointer;
    transition: width 0.25s, background 0.25s;
  }
  :global(.sliderkit__pagination-bullet--active) {
    width: 1.6rem;
    background: linear-gradient(90deg, var(--primary), var(--accent));
