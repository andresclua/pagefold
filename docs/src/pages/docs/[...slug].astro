---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  const sorted = [...docs].sort(
    (a, b) => a.data.section.localeCompare(b.data.section) || a.data.order - b.data.order
  )
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry, sorted } }))
}

const { entry, sorted } = Astro.props
const { Content } = await render(entry)
---

<Base title={entry.data.title} description={entry.data.description}>
  <div class="layout">
    <nav aria-label="Docs">
      <ul>
        {
          sorted.map((d) => (
            <li>
              <a href={`/docs/${d.id}`} aria-current={d.id === entry.id ? 'page' : undefined}>
                {d.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <article>
      <h1>{entry.data.title}</h1>
      <Content />
    </article>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 2rem;
    padding-block: 2rem;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a[aria-current='page'] {
    font-weight: 700;
  }
  @media (max-width: 40rem) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
