---
interface Item { text: string; tone?: 'new' | 'moved' | 'gone' }
interface Props { rows: { label: string; items: Item[] }[]; caption?: string }
const { rows, caption } = Astro.props
---

<figure class="strips">
  <div class="hint"><span>← least recently used</span><span>most recent →</span></div>
  {
    rows.map((r) => (
      <div class="row">
        <span class="label">{r.label}</span>
        <div class="items">
          {r.items.map((i) => <code class={`item ${i.tone ?? ''}`}>{i.text}</code>)}
        </div>
      </div>
    ))
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .strips { margin: 1.5rem 0; padding: 1rem; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); display: grid; gap: 0.7rem; }
  .hint { display: flex; justify-content: space-between; padding-left: 12rem; font: 0.72rem var(--font-head); color: var(--muted); }
  .row { display: grid; grid-template-columns: 11.25rem 1fr; gap: 0.75rem; align-items: center; }
  .label { font-size: 0.9rem; color: var(--muted); }
  .items { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .item { min-width: 4.5rem; text-align: center; padding: 0.4rem 0.7rem; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); }
  .new { border-color: color-mix(in srgb, var(--accent) 70%, var(--border)); background: color-mix(in srgb, var(--accent) 30%, var(--surface)); }
  .moved { border-color: var(--primary); background: color-mix(in srgb, var(--primary) 30%, var(--surface)); }
  .gone { border-style: dashed; color: var(--muted); text-decoration: line-through; background: transparent; }
  figcaption { color: var(--muted); font-size: 0.9rem; }
  @media (max-width: 40rem) { .row { grid-template-columns: 1fr; gap: 0.25rem; } .hint { padding-left: 0; } }
</style>
