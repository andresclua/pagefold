---
import '../styles/global.css'
import Logo from '../components/Logo.astro'

interface Props {
  title: string
  description?: string
}
const { title, description = 'Page transitions for server-rendered websites.' } = Astro.props
// Analytics are only added when one of these is set at build time: PUBLIC_GA_ID (Google Analytics 4)
// or PUBLIC_GTM_ID (Google Tag Manager)
const ga = import.meta.env.PUBLIC_GA_ID
const gtm = import.meta.env.PUBLIC_GTM_ID
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Pagefold</title>
    {ga && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`} />}
    {ga && (
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${ga}');`} />
    )}
    {gtm && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtm}');`} />
    )}
  </head>
  <body>
    {gtm && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}
    <header class="bar">
      <div class="wrap bar-inner">
        <a href="/" class="brand"><Logo size={26} /><span>Pagefold</span></a>
        <nav aria-label="Main">
          <a href="/docs/getting-started">Docs</a>
          <a href="/showcase">Showcase</a>
          <a href="https://github.com/andresclua/pagefold" class="gh">GitHub</a>
        </nav>
      </div>
    </header>
    <main id="pagefold" class="transition-fold">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot-inner">
        <span>MIT licensed. This site navigates with Pagefold.</span>
        <a href="https://github.com/andresclua/pagefold">GitHub</a>
      </div>
    </footer>
  </body>
</html>

<script>
  // This site navigates with Pagefold itself
  import Pagefold from 'pagefold'
  import PagefoldA11y from 'pagefold/a11y'
  import PagefoldAnalytics from 'pagefold/analytics'
  import PagefoldHead from 'pagefold/head'
  import PagefoldPreload from 'pagefold/preload'
  import PagefoldScroll from 'pagefold/scroll'

  const pagefold = new Pagefold({
    plugins: [
      new PagefoldHead({ awaitAssets: true }),
      new PagefoldA11y(),
      new PagefoldScroll({ duration: 500, animateScroll: { betweenPages: false } }),
      new PagefoldPreload(),
      // The first page is reported by the analytics snippet, the rest by this plugin
      ...(import.meta.env.PUBLIC_GA_ID ? [new PagefoldAnalytics({ provider: 'gtag' })] : []),
      ...(import.meta.env.PUBLIC_GTM_ID ? [new PagefoldAnalytics({ provider: 'gtm' })] : []),
    ],
  })

  // The diagrams that move as you read (GSAP and ScrollTrigger). `mount` sets each one up when it
  // arrives and cleans it up when it leaves, so no trigger is left behind after a visit.
  pagefold.mount<HTMLElement>('[data-motion]', (el) => {
    let stop: (() => void) | undefined
    let gone = false
    void import('../scripts/motion').then(({ animate }) => {
      if (!gone) stop = animate(el)
    })
    return () => {
      gone = true
      stop?.()
    }
  })
  // The page may still be moving when the triggers measure it: measure again when the visit is over
  pagefold.hooks.on('visit:end', () => {
    void import('../scripts/motion').then(({ refresh }) => refresh())
  })

  // One listener on the document: a script that belongs to a single page would not run again
  // when that page is reached by a visit, so the copy buttons are wired up here.
  document.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLElement>('[data-copy]')
    if (!button) return
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '')
      button.dataset.copied = 'true'
      setTimeout(() => delete button.dataset.copied, 1600)
    } catch {
      /* clipboard not available: the text is selectable anyway */
    }
  })
</script>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 0.9rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.4rem;
    align-items: center;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--text);
  }
  .foot {
    border-top: 1px solid var(--border);
    margin-top: 5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .foot-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.5rem;
  }
</style>
