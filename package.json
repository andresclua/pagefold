{
  "name": "pagefold",
  "version": "0.1.0",
  "description": "Page transitions for server-rendered websites.",
  "type": "module",
  "license": "MIT",
  "author": "Andres Clua",
  "homepage": "https://github.com/andresclua/pagefold#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresclua/pagefold.git"
  },
  "bugs": "https://github.com/andresclua/pagefold/issues",
  "keywords": [
    "page-transitions",
    "view-transitions",
    "spa",
    "animation"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./head": {
      "import": {
        "types": "./dist/plugins/head.d.ts",
        "default": "./dist/head.js"
      },
      "require": {
        "types": "./dist/plugins/head.d.cts",
        "default": "./dist/head.cjs"
      }
    },
    "./scripts": {
      "import": {
        "types": "./dist/plugins/scripts.d.ts",
        "default": "./dist/scripts.js"
      },
      "require": {
        "types": "./dist/plugins/scripts.d.cts",
        "default": "./dist/scripts.cjs"
      }
    },
    "./js": {
      "import": {
        "types": "./dist/plugins/js.d.ts",
        "default": "./dist/js.js"
      },
      "require": {
        "types": "./dist/plugins/js.d.cts",
        "default": "./dist/js.cjs"
      }
    },
    "./overlap": {
      "import": {
        "types": "./dist/plugins/overlap.d.ts",
        "default": "./dist/overlap.js"
      },
      "require": {
        "types": "./dist/plugins/overlap.d.cts",
        "default": "./dist/overlap.cjs"
      }
    },
    "./preload": {
      "import": {
        "types": "./dist/plugins/preload.d.ts",
        "default": "./dist/preload.js"
      },
      "require": {
        "types": "./dist/plugins/preload.d.cts",
        "default": "./dist/preload.cjs"
      }
    },
    "./a11y": {
      "import": {
        "types": "./dist/plugins/a11y.d.ts",
        "default": "./dist/a11y.js"
      },
      "require": {
        "types": "./dist/plugins/a11y.d.cts",
        "default": "./dist/a11y.cjs"
      }
    },
    "./scroll": {
      "import": {
        "types": "./dist/plugins/scroll.d.ts",
        "default": "./dist/scroll.js"
      },
      "require": {
        "types": "./dist/plugins/scroll.d.cts",
        "default": "./dist/scroll.cjs"
      }
    },
    "./body-class": {
      "import": {
        "types": "./dist/plugins/body-class.d.ts",
        "default": "./dist/body-class.js"
      },
      "require": {
        "types": "./dist/plugins/body-class.d.cts",
        "default": "./dist/body-class.cjs"
      }
    },
    "./debug": {
      "import": {
        "types": "./dist/plugins/debug.d.ts",
        "default": "./dist/debug.js"
      },
      "require": {
        "types": "./dist/plugins/debug.d.cts",
        "default": "./dist/debug.cjs"
      }
    },
    "./route-name": {
      "import": {
        "types": "./dist/plugins/route-name.d.ts",
        "default": "./dist/route-name.js"
      },
      "require": {
        "types": "./dist/plugins/route-name.d.cts",
        "default": "./dist/route-name.cjs"
      }
    },
    "./progress": {
      "import": {
        "types": "./dist/plugins/progress.d.ts",
        "default": "./dist/progress.js"
      },
      "require": {
        "types": "./dist/plugins/progress.d.cts",
        "default": "./dist/progress.cjs"
      }
    },
    "./forms": {
      "import": {
        "types": "./dist/plugins/forms.d.ts",
        "default": "./dist/forms.js"
      },
      "require": {
        "types": "./dist/plugins/forms.d.cts",
        "default": "./dist/forms.cjs"
      }
    },
    "./fragment": {
      "import": {
        "types": "./dist/plugins/fragment.d.ts",
        "default": "./dist/fragment.js"
      },
      "require": {
        "types": "./dist/plugins/fragment.d.cts",
        "default": "./dist/fragment.cjs"
      }
    },
    "./analytics": {
      "import": {
        "types": "./dist/plugins/analytics.d.ts",
        "default": "./dist/analytics.js"
      },
      "require": {
        "types": "./dist/plugins/analytics.d.cts",
        "default": "./dist/analytics.cjs"
      }
    },
    "./css/*": "./dist/css/*",
    "./umd/*": "./dist/umd/*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/make-dcts.mjs && node scripts/copy-css.mjs && node scripts/build-umd.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-check.mjs",
    "docs:dev": "pnpm --filter pagefold-docs dev",
    "docs:build": "pnpm --filter pagefold-docs build",
    "prepare": "husky",
    "test:e2e": "pnpm build && playwright test -c tests/e2e/playwright.config.ts",
    "check:package": "attw --pack .",
    "check:showcase": "node scripts/check-showcase.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "alpinejs": "^3.17.5",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "gia": "1.0.1",
    "gsap": "^3.15.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "motion": "^14.9.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.0",
  "unpkg": "./dist/umd/pagefold.js",
  "jsdelivr": "./dist/umd/pagefold.js",
  "typesVersions": {
    "*": {
      "head": [
        "dist/plugins/head.d.ts"
      ],
      "scripts": [
        "dist/plugins/scripts.d.ts"
      ],
      "js": [
        "dist/plugins/js.d.ts"
      ],
      "overlap": [
        "dist/plugins/overlap.d.ts"
      ],
      "preload": [
        "dist/plugins/preload.d.ts"
      ],
      "a11y": [
        "dist/plugins/a11y.d.ts"
      ],
      "scroll": [
        "dist/plugins/scroll.d.ts"
      ],
      "body-class": [
        "dist/plugins/body-class.d.ts"
      ],
      "debug": [
        "dist/plugins/debug.d.ts"
      ],
      "route-name": [
        "dist/plugins/route-name.d.ts"
      ],
      "progress": [
        "dist/plugins/progress.d.ts"
      ],
      "forms": [
        "dist/plugins/forms.d.ts"
      ],
      "fragment": [
        "dist/plugins/fragment.d.ts"
      ],
      "analytics": [
        "dist/plugins/analytics.d.ts"
      ]
    }
  }
}
