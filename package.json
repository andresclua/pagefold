{
  "name": "pagefold",
  "version": "0.0.0",
  "description": "Page transitions for server-rendered websites.",
  "type": "module",
  "license": "MIT",
  "author": "Andres Clua",
  "homepage": "https://pagefold.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresclua/pagefold.git"
  },
  "bugs": "https://github.com/andresclua/pagefold/issues",
  "keywords": [
    "page-transitions",
    "view-transitions",
    "spa",
    "animation"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./head": {
      "types": "./dist/plugins/head.d.ts",
      "import": "./dist/head.js",
      "require": "./dist/head.cjs"
    },
    "./scripts": {
      "types": "./dist/plugins/scripts.d.ts",
      "import": "./dist/scripts.js",
      "require": "./dist/scripts.cjs"
    },
    "./js": {
      "types": "./dist/plugins/js.d.ts",
      "import": "./dist/js.js",
      "require": "./dist/js.cjs"
    },
    "./overlap": {
      "types": "./dist/plugins/overlap.d.ts",
      "import": "./dist/overlap.js",
      "require": "./dist/overlap.cjs"
    },
    "./preload": {
      "types": "./dist/plugins/preload.d.ts",
      "import": "./dist/preload.js",
      "require": "./dist/preload.cjs"
    },
    "./a11y": {
      "types": "./dist/plugins/a11y.d.ts",
      "import": "./dist/a11y.js",
      "require": "./dist/a11y.cjs"
    },
    "./scroll": {
      "types": "./dist/plugins/scroll.d.ts",
      "import": "./dist/scroll.js",
      "require": "./dist/scroll.cjs"
    },
    "./body-class": {
      "types": "./dist/plugins/body-class.d.ts",
      "import": "./dist/body-class.js",
      "require": "./dist/body-class.cjs"
    },
    "./debug": {
      "types": "./dist/plugins/debug.d.ts",
      "import": "./dist/debug.js",
      "require": "./dist/debug.cjs"
    },
    "./route-name": {
      "types": "./dist/plugins/route-name.d.ts",
      "import": "./dist/route-name.js",
      "require": "./dist/route-name.cjs"
    },
    "./progress": {
      "types": "./dist/plugins/progress.d.ts",
      "import": "./dist/progress.js",
      "require": "./dist/progress.cjs"
    },
    "./forms": {
      "types": "./dist/plugins/forms.d.ts",
      "import": "./dist/forms.js",
      "require": "./dist/forms.cjs"
    },
    "./fragment": {
      "types": "./dist/plugins/fragment.d.ts",
      "import": "./dist/fragment.js",
      "require": "./dist/fragment.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-check.mjs",
    "docs:dev": "pnpm --filter pagefold-docs dev",
    "docs:build": "pnpm --filter pagefold-docs build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.0"
}
