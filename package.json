{
  "name": "pagefold",
  "version": "0.0.0",
  "description": "Page transitions for server-rendered websites.",
  "type": "module",
  "license": "MIT",
  "author": "Andres Clua",
  "homepage": "https://pagefold.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresclua/pagefold.git"
  },
  "bugs": "https://github.com/andresclua/pagefold/issues",
  "keywords": [
    "page-transitions",
    "view-transitions",
    "spa",
    "animation"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-check.mjs",
    "docs:dev": "pnpm --filter pagefold-docs dev",
    "docs:build": "pnpm --filter pagefold-docs build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
